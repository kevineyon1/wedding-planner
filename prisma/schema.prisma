// Kevin Wedding Planner — Prisma schema
// Data master disimpan di DB; angka turunan (total, sisa) dihitung on-the-fly.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Vendor / kandidat vendor per kategori
model Vendor {
  id             Int       @id @default(autoincrement())
  nama           String
  kategori       String // Venue, Katering, Dekorasi, Dokumentasi, MUA, Busana, dll
  kontak         String? // WA / IG / telepon
  hargaPenawaran Int       @default(0) // dalam Rupiah, SELALU total (dihitung otomatis kalau hargaMode = per_pax)
  hargaMode      String    @default("total") // total | per_pax
  hargaPerPax    Int? // nominal per pax, dipakai kalau hargaMode = per_pax
  pax            Int? // kapasitas tamu, relevan utk kategori Venue
  deskripsiPaket String?
  status         String    @default("wishlist") // wishlist | shortlist | dipilih | booked
  link           String?
  catatan        String?
  brosurPath     String? // nama file di disk (folder uploads/, di luar public/)
  brosurNama     String? // nama asli file saat diupload, utk ditampilkan
  payments       Payment[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// Pembayaran ke vendor (DP / pelunasan) — legacy, tidak dipakai lagi (digantikan Transaction)
model Payment {
  id              Int       @id @default(autoincrement())
  vendorId        Int
  vendor          Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  jumlah          Int       @default(0) // nominal pembayaran
  jenis           String    @default("dp") // dp | pelunasan | lainnya
  tanggalBayar    DateTime?
  tanggalJatuhTempo DateTime?
  status          String    @default("belum") // belum | lunas
  catatan         String?
  createdAt       DateTime  @default(now())
}

/// Transaksi finansial — independen dari katalog Vendor, kategori & nama diisi langsung.
model Transaction {
  id         Int                  @id @default(autoincrement())
  acara      String               @default("wedding") // wedding | sanjit
  kategori   String // dari daftar KATEGORI_VENDOR, atau "Lainnya"
  namaVendor String // nama vendor/penerima, diketik bebas
  qty        Int                  @default(1) // jumlah orang/unit; totalHarga tetap total keseluruhan
  totalHarga Int                  @default(0)
  deadline   DateTime? // opsional, target tanggal lunas
  catatan    String?
  payments   TransactionPayment[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
}

/// Riwayat pembayaran per transaksi (DP, cicilan, pelunasan, dll)
model TransactionPayment {
  id            Int         @id @default(autoincrement())
  transactionId Int
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  jumlah        Int         @default(0)
  jenis         String      @default("dp") // dp | cicilan | pelunasan | lainnya
  tanggalBayar  DateTime?
  catatan       String?
  createdAt     DateTime    @default(now())
}

/// Tugas persiapan (checklist)
model Todo {
  id        Int       @id @default(autoincrement())
  judul     String
  kategori  String    @default("Umum")
  status    String    @default("belum") // belum | proses | selesai
  prioritas String    @default("normal") // rendah | normal | tinggi
  deadline  DateTime?
  catatan   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Daftar tamu
model Guest {
  id          Int      @id @default(autoincrement())
  nama        String
  kategori    String   @default("Teman") // Keluarga | Teman | Kolega | dll
  sisi        String   @default("pria") // pria | wanita
  jumlahOrang Int      @default(1)
  status      String   @default("rencana") // rencana | diundang | konfirmasi
  noWhatsapp  String? // opsional, format bebas
  catatan     String?
  createdAt   DateTime @default(now())
}

/// Alokasi budget per kategori (opsional / perencanaan)
model BudgetCategory {
  id            Int    @id @default(autoincrement())
  namaKategori  String @unique
  alokasiRencana Int   @default(0)
}

/// Tabungan (aset) — dicatat manual per tanggal nambah, dibandingkan dgn
/// Beban yang ditarik otomatis dari total sudah dibayar di Finance.
model Tabungan {
  id        Int      @id @default(autoincrement())
  jumlah    Int      @default(0)
  tanggal   DateTime @default(now())
  catatan   String?
  createdAt DateTime @default(now())
}

/// Pengaturan global (single-row)
model Setting {
  id             Int      @id @default(1)
  namaPengantin1 String   @default("")
  namaPengantin2 String   @default("")
  tanggalHariH   DateTime?
  totalAnggaran  Int      @default(0)
  updatedAt      DateTime @updatedAt
}
